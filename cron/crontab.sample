# ==============================================================================
# Linux Backup Automation Suite - Cron Job Schedule Template
# Author: Aishwary Gupta
#
# Usage:
#   To install manually:
#     crontab -e
#     (Paste desired lines below with absolute paths)
#
#   Or run the automated installer:
#     ./cron/setup-cron.sh
# ==============================================================================

# SHELL environment
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# 1. Daily Backup: Executes every night at 2:00 AM
0 2 * * * /path/to/linux-backup-suite/backup.sh >> /path/to/linux-backup-suite/logs/cron_backup.log 2>&1

# 2. Automated Retention Cleanup: Executes every Sunday at 3:30 AM
30 3 * * 0 /path/to/linux-backup-suite/cleanup.sh >> /path/to/linux-backup-suite/logs/cron_cleanup.log 2>&1

# 3. Health & Integrity Check: Runs daily at 6:00 AM
0 6 * * * /path/to/linux-backup-suite/health-check.sh >> /path/to/linux-backup-suite/logs/cron_health.log 2>&1

# 4. Monitoring & Alerting: Runs twice daily at 8:00 AM and 8:00 PM
0 8,20 * * * /path/to/linux-backup-suite/monitor.sh >> /path/to/linux-backup-suite/logs/cron_monitor.log 2>&1
